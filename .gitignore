.venv/
__pycache__/
*.py[cod]
.env
.pytest_cache/
.mypy_cache/
.ruff_cache/
.DS_Store

# I documenti indicizzati restano in locale: non vanno versionati.
data/documents/**/*.pdf

# Il catalogo è locale come i documenti che descrive. Ce n'è uno per store,
# quindi il nome segue VECTOR_STORE: il pattern li copre tutti.
data/catalog*.sqlite3
data/catalog*.sqlite3-journal
data/catalog*.sqlite3.lock

# Lo stesso vale per il vector store locale: è la libreria indicizzata, non
# codice, e si ricostruisce con un sync.
data/chroma/

# Le domande di valutazione sono scritte sui documenti e citano cosa contengono:
# private quanto i documenti da cui vengono. La suite di test se ne costruisce
# uno suo, sui PDF di prova, e non ha bisogno di questo file.
data/evals/

# Le conversazioni contengono le domande e le risposte: private quanto i
# documenti che citano.
data/conversations*.sqlite3*

# Optional local caches if configured inside the project
.huggingface/
.cache/

# Claude Code: configurazione locale della macchina
.claude/settings.local.json

# GitNexus: l'indice del codice e i file che riscrive a ogni analisi.
# Sono strumenti della macchina, non parte del progetto: restano in locale.
.gitnexus/
AGENTS.md
CLAUDE.md
.claude/skills/gitnexus-*/
